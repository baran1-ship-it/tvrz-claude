; Puchart – Godot 4.4.1, renderer Compatibility (tablet Xiaomi Pad 8). Pravidla: CLAUDE.md, pravidla/svet/rozpocty.json.

config_version=5

[application]

config/name="Puchart 1393"
run/main_scene="res://scenes/svet.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.6, 0.7, 0.8, 1)
