+func _diag(root: Node3D) -> void:
+	for kind: String in ["mech_1", "mech_2", "mech_3", "moss_01", "rock_moss_set_01", "tree_stump_01", "tree_stump_02", "root_cluster_01"]:
+		var path := MOD + "rostliny/%s.glb" % kind
+		if not ResourceLoader.exists(path):
+			print("DIAG ", kind, " chybi")
+			continue
+		var inst := (load(path) as PackedScene).instantiate()
+		for n in inst.find_children("*", "MeshInstance3D", true, false):
+			var me := (n as MeshInstance3D).mesh
+			for i in me.get_surface_count():
+				var a := me.surface_get_arrays(i)
+				var mt := me.surface_get_material(i)
+				var s := "DIAG %s %s s%d fmt=%d norm=%s col=%s uv=%s " % [kind, n.name, i, me.surface_get_format(i), a[Mesh.ARRAY_NORMAL] != null, a[Mesh.ARRAY_COLOR] != null, a[Mesh.ARRAY_TEX_UV] != null]
+				if a[Mesh.ARRAY_COLOR] != null:
+					var cc: PackedColorArray = a[Mesh.ARRAY_COLOR]
+					var sm := Color(0, 0, 0, 0)
+					for c in cc:
+						sm += c
+					s += "colavg=%s " % (sm / maxf(cc.size(), 1))
+				if a[Mesh.ARRAY_NORMAL] != null:
+					var nn: PackedVector3Array = a[Mesh.ARRAY_NORMAL]
+					s += "n0=%s " % (nn[0] if nn.size() > 0 else Vector3.ZERO)
+				if mt is BaseMaterial3D:
+					var b := mt as BaseMaterial3D
+					s += "mat=%s shade=%d alb=%s atex=%s vcol=%s met=%.2f mtex=%s rough=%.2f rtex=%s nor=%s ntex=%s ao=%s tr=%d cull=%d spec=%.2f" % [b.resource_name, b.shading_mode, b.albedo_color, b.albedo_texture.resource_path if b.albedo_texture else "-", b.vertex_color_use_as_albedo, b.metallic, b.metallic_texture.resource_path if b.metallic_texture else "-", b.roughness, b.roughness_texture.resource_path if b.roughness_texture else "-", b.normal_enabled, b.normal_texture.resource_path if b.normal_texture else "-", b.ao_enabled, b.transparency, b.cull_mode, b.metallic_specular]
+				else:
+					s += "mat=%s" % mt
+				print(s)
+		inst.free()
+	# zahrady: spodek rostlin vs. teren
+	for mi in root.find_children("*_zahrady*", "MeshInstance3D", true, false):
+		var me := (mi as MeshInstance3D).mesh
+		var xf := (mi as MeshInstance3D).global_transform
+		var bins := {}
+		for si in me.get_surface_count():
+			var mt := me.surface_get_material(si)
+			for v: Vector3 in me.surface_get_arrays(si)[Mesh.ARRAY_VERTEX]:
+				var w := xf * v
+				var c := Vector2i(floori(w.x / 0.6), floori(w.z / 0.6))
+				bins[c] = minf(float(bins.get(c, INF)), w.y)
+		var hist := {}
+		var k := 0
+		for c: Vector2i in bins:
+			var x := (c.x + 0.5) * 0.6
+			var z := (c.y + 0.5) * 0.6
+			var dy := float(bins[c]) - _vyska(x, z)
+			var b := clampi(roundi(dy * 10.0), -10, 10)
+			hist[b] = int(hist.get(b, 0)) + 1
+			k += 1
+			if k % 400 == 0:
+				print("DIAG zahr ", Vector2(x, z), " spodek ", bins[c], " ter ", _vyska(x, z), " fort? ")
+		var ks := hist.keys()
+		ks.sort()
+		var s2 := ""
+		for b: int in ks:
+			s2 += "%.1f:%d " % [b / 10.0, hist[b]]
+		print("DIAG zahrady ", mi.name, " povrchu ", me.get_surface_count(), " histogram spodek-teren [m:pocet] ", s2)
