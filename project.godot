; Odkaz Havrana - tvrz k prochazeni. Godot 4.4.
config_version=5

[application]

config/name="Odkaz Havrana"
config/version="0.78"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.04, 0.04, 0.05, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[display]

window/frame_pacing/android/enable_frame_pacing=true

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=12.0

[rendering]

mesh_lod/lod_change/threshold_pixels=4.0

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/anisotropic_filtering_level.mobile=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)

[debug]

file_logging/enable_file_logging=true
